# 9router-go environment contract
# Copy to .env and fill in values.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
# Optional override; leave unset so Go and the Next.js dashboard share ~/.9router (%APPDATA%\9router on Windows).
# DATA_DIR=/var/lib/9router
# Optional: 64-hex or passphrase key to encrypt stored provider API/OAuth tokens at rest (AES-256-GCM).
# Leave unset only when sharing data.sqlite with the Next.js dashboard in plaintext compatibility mode.
# CREDENTIAL_ENCRYPTION_KEY=

# Server
# HOST=127.0.0.1
PORT=20128
# Unified 1-gateway mode: proxy UI/management routes to companion Next.js dashboard.
# Leave empty to run headless Go proxy only.
# DASHBOARD_URL=http://127.0.0.1:3000

# OAuth client credentials
# Required for token refresh on each OAuth provider you enable.
# 9router-go does not embed Google/iflow/Claude/xAI OAuth secrets; configure explicitly.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# CLAUDE_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=
